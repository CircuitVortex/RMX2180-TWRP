#
# system.prop for RMX2180
#

# Softkey / navigation
ro.vendor.mtk_emmc_support=1

# Crypto
ro.crypto.volume.filenames_mode=aes-256-cts
ro.crypto.allow_encrypt_override=true

# Realme / Oppo specific
ro.product.device=RMX2180
ro.product.system.device=RMX2180
ro.product.vendor.device=oppo6765
ro.board.platform=mt6765
ro.boot.hardware=mt6765

# Treble
ro.treble.enabled=true

# FBE
ro.crypto.type=file
ro.crypto.volume.levels=1
ro.crypto.volume.contents_mode=aes-256-xts
ro.crypto.volume.filenames_mode=aes-256-cts
